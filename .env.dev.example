# Copy to .env (`just init-env` does it for you). Never commit .env.
#
# Only `just deploy` reads any of this; running and testing locally needs none
# of it. These credentials reach every Session on the host — the link may be the
# only key to a Session, but FTP is the key to all of them.

FTP_HOST=ftp.cluster0XX.hosting.ovh.net
FTP_USER=quelprenomxyz
FTP_PASSWORD=

# The DocumentRoot of quelprenom.xyz, relative to the FTP home.
FTP_REMOTE_DIR=www
